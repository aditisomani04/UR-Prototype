{
  "version": 1,
  "sdk_version": "3.0.6",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "ur-driver-s-delight",
      "version": "0.1.0",
      "title": "UR Driver's Delight"
    },
    "tools": [
      {
        "name": "list_schedule",
